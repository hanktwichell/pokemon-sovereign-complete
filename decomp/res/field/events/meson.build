)

events_headers = []
foreach events_file : events_files
    events_h = events_file.full_path().split('/')[-1].split('.')[0] + '.h'
    events_headers += custom_target(events_h,
        output: events_h,
        input: events_file,
        command: [
            datagen_events_exe,
            events_file,
            events_h,
            meson.current_build_dir(),
        ],
    )
endforeach

events_order = files('zone_event.order')
events_narc = custom_target('zone_event.narc',
    output: [
        'zone_event.narc',
        'zone_event.naix',
    ],
    input: event_bin_gen.process(events_files, env: jsoncnv_env),
    depends: [ py_consts_generators, events_headers ],
    command: [
        nitroarc_exe,
        '--create',
        '--index',
        '--files-from', files('zone_event.order'),
        '--file', '@OUTPUT0@',
        '@PRIVATE_DIR@',
    ],
)

nitrofs_files += events_narc
naix_headers += events_narc[1]
