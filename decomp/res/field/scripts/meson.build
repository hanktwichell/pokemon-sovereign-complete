scr_seq_narc = custom_target('scr_seq.narc',
    output: [
        'scr_seq.narc',
        'scr_seq.naix',
    ],
    input: script_bin_gen.process(
        scr_seq_files,
        extra_args: ['--out-dir', scr_seq_private_dir],
        depends: [
            events_headers,
            text_banks,
        ],
    ),
    command: [
        nitroarc_exe,
        '--create',
        '--index',
        '--files-from', files('scripts.order'),
        '--file', '@OUTPUT0@',
        '@PRIVATE_DIR@',
    ],
)

nitrofs_files += scr_seq_narc
naix_headers += scr_seq_narc[1]
