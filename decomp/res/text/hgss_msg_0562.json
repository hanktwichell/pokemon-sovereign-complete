  "key": 5246,
  "messages": [
    {
      "id": "msg_0562_T22R0601_00000",
      "en_US": [
        "A Pokémon you get in a trade\n",
        "grows quickly.\r",
        "But if you don’t have the right Gym\n",
        "Badge, they may disobey you."
      ]
    },
    {
      "id": "msg_0562_T22R0601_00001",
      "en_US": [
        "I collect Pokémon!\n",
        "Do you have Rhyhorn?\r",
        "Want to trade it for my Gligar?"
      ]
    },
    {
      "id": "msg_0562_T22R0601_00002",
      "en_US": [
        "Ho ho! I got myself Rhyhorn!\n",
        "Thank you!"
      ]
    },
    {
      "id": "msg_0562_T22R0601_00003",
      "en_US": "Eh? That’s not a Rhyhorn."
    },
    {
      "id": "msg_0562_T22R0601_00004",
      "en_US": [
        "You don’t want to trade?\n",
        "That’s a shame!"
      ]
    },
    {
      "id": "msg_0562_T22R0601_00005",
      "en_US": [
        "Hi, how’s my buddy Rhyhorn doing?\n",
        "Is he a strong Rhyperior yet?"
      ]
    },
    {
      "id": "msg_0562_T22R0601_00006",
      "en_US": [
        "After the conclusion of the trade, a\n",
        "mysterious sphere appeared in midair...\r"
      ]
    }
  ]
}
