{
  "key": 12115,
  "messages": [
    {
      "id": "msg_0515_T08PC0101_00000",
      "en_US": [
        "Hey! You have a Pokédex!\n",
        "Did Professor Oak give that to you?"
      ]
    },
    {
      "id": "msg_0515_T08PC0101_00001",
      "en_US": [
        "I got quite a shock at the Gym.\n",
        "There were all these girls who\f",
        "looked identical."
      ]
    },
    {
      "id": "msg_0515_T08PC0101_00002",
      "en_US": [
        "I’m Janine! Hocus-pocus...\n",
        "Poof!\r"
      ]
    },
    {
      "id": "msg_0515_T08PC0101_00003",
      "en_US": [
        "See? I look just like her now!\r",
        "...?\r",
        "Huh? Didn’t work?"
      ]
    },
    {
      "id": "msg_0515_T08PC0101_00004",
      "en_US": "Cloyster: Crouu!"
    },
    {
      "id": "msg_0515_T08PC0101_00005",
      "en_US": [
        "Do you want to...\n",
        "heal your Pokémon..? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0515_T08PC0101_00006",
      "en_US": [
        "It doesn’t look like Cloyster\n",
        "cares about your response..."
      ]
    },
    {
      "id": "msg_0515_T08PC0101_00007",
      "en_US": "Shellder: Herr!"
    },
    {
      "id": "msg_0515_T08PC0101_00008",
      "en_US": "Shellder: Derr..."
    },
    {
      "id": "msg_0515_T08PC0101_00009",
      "en_US": "Slowpoke: ...Yawn?"
    },
    {
      "id": "msg_0515_T08PC0101_00010",
      "en_US": [
        "Cloyster ignored your answer,\n",
        "looking for a fight!\r"
      ]
    },
    {
      "id": "msg_0515_T08PC0101_00011",
      "en_US": [
        "Woah!\n",
        "This Cloyster looks a bit different..!\r"
      ]
    },
    {
      "id": "msg_0515_T08PC0101_00012",
      "en_US": [
        "The not-so-lazy Pokémon fled\n",
        "the scene after the Cloyster was\f",
        "defeated."
      ]
    }
  ]
}
