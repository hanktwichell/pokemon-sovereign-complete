{
  "key": 60483,
  "messages": [
    {
      "id": "msg_0593_T25R1002_00000",
      "en_US": [
        "The ladies at this department store\n",
        "even greet kids like me with respect.\r",
        "That’s what I call professional!"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00001",
      "en_US": [
        "The ladies at this department store\n",
        "never change their attitude.\r",
        "Be it in front of a regular customer\n",
        "or a Team Rocket member.\r",
        "That’s what I call professional!"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00002",
      "en_US": [
        "The existence of this department store\n",
        "tells me that Goldenrod is a big city.\r",
        "The selection here is unmatched\n",
        "anywhere else."
      ]
    },
    {
      "id": "msg_0593_T25R1002_00003",
      "en_US": [
        "You better listen to me.\r",
        "Quit being a Team Rocket member\n",
        "already!"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00004",
      "en_US": [
        "I got my Smeargle at the Game Corner.\f",
        "Now it’s my best partner."
      ]
    },
    {
      "id": "msg_0593_T25R1002_00005",
      "en_US": [
        "Oh, Team Rocket!\n",
        "Please don’t take my Cacnea away!"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00006",
      "en_US": [
        "Your Travel Companion\n",
        "2F Trainer’s Market"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00007",
      "en_US": [
        "Hm? Who are you? A Pokémon Trainer, I\n",
        "presume?\r",
        "Your name is {STRVAR_1 3, 0, 0}? I see...\r",
        "I’m Cynthia. I’m visiting Johto on\n",
        "some archaeology business.\r",
        "I assume you’ve seen the Ruins of Alph?\n",
        "A very interesting place, indeed...\r",
        "Well, {STRVAR_1 3, 0, 0}, perhaps we’ll cross paths\n",
        "in the future. It was nice to meet you."
      ]
    },
    {
      "id": "msg_0593_T25R1002_00008",
      "en_US": [
        "Perhaps we’ll cross paths in the\n",
        "future. It was nice to meet you."
      ]
    },
    {
      "id": "msg_0593_T25R1002_00009",
      "en_US": [
        "Hey, hey! Did you know they sell\n",
        "some evolution stones here now?"
      ]
    },
    {
      "id": "msg_0593_T25R1002_00010",
      "en_US": "Igglybuff: Buubuu!"
    }
  ]
}
