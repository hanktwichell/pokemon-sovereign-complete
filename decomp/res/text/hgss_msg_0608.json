{
  "key": 21590,
  "messages": [
    {
      "id": "msg_0608_T26R0301_00000",
      "en_US": [
        "Hi, I’m looking for a Pokémon!\r",
        "If you have an Electabuzz, would\n",
        "you trade it for my Skarmory?"
      ]
    },
    {
      "id": "msg_0608_T26R0301_00001",
      "en_US": [
        "Great! Thank you!\r",
        "I finally got an Electabuzz!"
      ]
    },
    {
      "id": "msg_0608_T26R0301_00002",
      "en_US": [
        "You don’t have a Electabuzz?\n",
        "That’s too bad, then."
      ]
    },
    {
      "id": "msg_0608_T26R0301_00003",
      "en_US": [
        "You don’t have one either?\r",
        "That’s really disappointing..."
      ]
    },
    {
      "id": "msg_0608_T26R0301_00004",
      "en_US": [
        "Hi! The Electabuzz you traded me is\n",
        "doing great!"
      ]
    },
    {
      "id": "msg_0608_T26R0301_00005",
      "en_US": [
        "Everyone loves Jasmine and her\n",
        "Steel-type Pokémon!\r",
        "Let me give you something so\n",
        "you can have Steel-typed Pokémon!\r"
      ]
    },
    {
      "id": "msg_0608_T26R0301_00006",
      "en_US": [
        "That Metal Coat is said to work on\n",
        "few Pokémon, but will give compatible\f",
        "Pokémon a coat of...\r",
        "...well, metal!"
      ]
    },
    {
      "id": "msg_0608_T26R0301_00007",
      "en_US": [
        "After the conclusion of the trade, a\n",
        "mysterious sphere appeared in midair...\r"
      ]
    }
  ]
}
